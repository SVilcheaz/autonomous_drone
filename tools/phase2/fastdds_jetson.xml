<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Scope this profile to perception processes. Static peers select discovery
       peers; this list also constrains the data locators advertised to WSL. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>uav_wired_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>192.168.50.2</address>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="uav_wired_perception" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>uav_wired_udp</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
