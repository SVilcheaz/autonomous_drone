<?xml version="1.0"?>
<package format="3">
  <name>autonomous_drone_perception</name>
  <version>0.1.0</version>
  <description>Calibrated CUDA stereo launch and source-aligned metric depth contract.</description>
  <maintainer email="vilceanu@users.noreply.github.com">vilceanu</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>stereo_msgs</depend>
  <depend>std_msgs</depend>
  <depend>message_filters</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>isaac_ros_stereo_image_proc</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
